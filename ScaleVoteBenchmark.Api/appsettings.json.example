{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DatabaseProvider": "Sqlite",

  "// UseManagedIdentity": "false = connect via connection string (username/password, less secure); true = Azure AD Managed Identity",
  "UseManagedIdentity": false,

  "Auth": {
    "// Enabled": "true = POST /api/vote/add requires a valid JWT (from POST /api/auth/login); false = it can be called without a token",
    "Enabled": false
  },

  "Startup": {
    "// FailFastOnDbCheck": "true = the application stops immediately if the database is unavailable at startup; false = only a warning is written to the log",
    "FailFastOnDbCheck": true
  },

  "ConnectionStrings": {
    "MsSql": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=ScaleVoteBenchmarkDb;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=True;TrustServerCertificate=False;",
    "MySql": "Server=YOUR-SERVER.mysql.database.azure.com;Port=3306;Database=ScaleVoteBenchmarkDb;Uid=YOUR-USER;Pwd=YOUR-PASSWORD;SslMode=Required;",
    "PostgreSql": "Server=YOUR-SERVER.postgres.database.azure.com;Port=5432;Database=ScaleVoteBenchmarkDb;User Id=YOUR-USER;Password=YOUR-PASSWORD;SSL Mode=Require;Trust Server Certificate=true;",
    "// Sqlite": "Local file, no server needed - handy for running/testing the app without an Azure database.",
    "Sqlite": "Data Source=scalevotebenchmark.db"
  },

  "Cache": {
    "// Enabled": "true = voting results are cached (MemoryCache); false = every retrieval goes straight to the database",
    "Enabled": true,
    "SlidingExpirationMinutes": 5
  },

  "Load": {
    "CpuIterationsPerVote": 200000,
    "MemoryMegabytesPerVote": 5,
    "DiskWriteKilobytesPerVote": 64
  },

  "Jwt": {
    "Key": "abcdefghijklmnopqrstuvwxyz012345",
    "Issuer": "ScaleVoteBenchmark.Api",
    "Audience": "ScaleVoteBenchmark.Clients",
    "ExpirationMinutes": 60
  },

  "AdminUser": {
    "Username": "admin",
    "Password": "admin"
  }
}
