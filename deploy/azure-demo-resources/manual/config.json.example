{
  "// AdminPassword": "Never put the password here. Deploy.ps1 always prompts for it separately, even when the rest of this file is loaded.",
  "// Mode": "'All' deploys all seven modules in order. 'Single' deploys only -Module. Omit for the interactive menu.",
  "Mode": "All",

  "// Module": "Only used when Mode is 'Single'. One of: 01 Log Analytics workspace, 02 single VM (vertical scaling), 03 VM Scale Set (horizontal scaling), 04 App Service (horizontal + approval-gated vertical scaling), 05 Azure SQL Serverless (vertical scaling), 06 Automation (Logic Apps, alerts, runbooks), 07 monitoring dashboard.",
  "Module": "",

  "AdminUsername": "demoadmin",
  "ResourceGroupPrefix": "ScaleTriggerDemo",
  "ResourcePrefix": "ScaleTrigger",

  "// SubscriptionId": "Leave empty to use whatever subscription is already active in the Az context.",
  "SubscriptionId": "",

  "Location": "eastus",

  "// ApprovalNotificationUpn": "Azure AD account UPN that receives the approval-gated scaling push notification.",
  "ApprovalNotificationUpn": "you@example.com",

  "AutoShutdownHour": 5,
  "AutoShutdownEnabled": true,
  "DeploymentMaxAttempts": 5,
  "DeploymentRetryDelaySeconds": 60,
  "SqlWarmupRetryDelaySeconds": 15
}
