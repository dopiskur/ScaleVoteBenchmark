@using ScaleVoteBenchmark.Lib.Models
@model VoteCounts

@{
    ViewData["Title"] = "Rezultati";
}

<h1>Rezultati glasovanja</h1>

<div class="results">
    <p>🐶 Pas: <span id="countPas">@Model.Pas</span></p>
    <p>🐱 Mačka: <span id="countMacka">@Model.Macka</span></p>
</div>

<form asp-controller="Login" asp-action="Logout" method="post" style="margin-top: 30px;">
    <button type="submit">Odjava</button>
</form>

<script>
    // Periodično osvježavanje rezultata svakih 3 sekunde bez ponovnog
    // učitavanja cijele stranice.
    setInterval(async () => {
        try {
            const response = await fetch('/Admin/Results');
            if (!response.ok) {
                return;
            }
            const data = await response.json();
            document.getElementById('countPas').innerText = data.pas;
            document.getElementById('countMacka').innerText = data.macka;
        } catch (e) {
            console.error('Greška prilikom dohvaćanja rezultata', e);
        }
    }, 3000);
</script>
