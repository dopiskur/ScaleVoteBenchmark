@{
    ViewData["Title"] = "Prijava";
}

<h1>Administratorska prijava</h1>

@if (ViewBag.Error != null)
{
    <p class="error">@ViewBag.Error</p>
}

<form asp-controller="Login" asp-action="Index" method="post">
    <div><input type="text" name="username" placeholder="Korisničko ime" required /></div>
    <div><input type="password" name="password" placeholder="Lozinka" required /></div>
    <div><button type="submit">Prijava</button></div>
</form>

<p style="margin-top: 20px;">
    <a asp-controller="Home" asp-action="Index">Natrag na glasovanje</a>
</p>
