{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DatabaseProvider": "Sqlite",

  "// UseManagedIdentity": "false = connect via connection string (username/password, less secure); true = Azure AD Managed Identity",
  "UseManagedIdentity": false,

  "Auth": {
    "// Enabled": "true = POST /api/vote/add requires a valid JWT (from POST /api/auth/login); false = it can be called without a token",
    "Enabled": false
  },

  "Startup": {
    "// FailFastOnDbCheck": "true = the application stops immediately if the database is unavailable at startup; false = only a warning is written to the log",
    "FailFastOnDbCheck": true
  },

  "ConnectionStrings": {
    "MsSql": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=ScaleTriggerDb;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=True;TrustServerCertificate=True;",
    "MySql": "Server=YOUR-SERVER.mysql.database.azure.com;Port=3306;Database=ScaleTriggerDb;Uid=YOUR-USER;Pwd=YOUR-PASSWORD;SslMode=Required;",
    "PostgreSql": "Server=YOUR-SERVER.postgres.database.azure.com;Port=5432;Database=ScaleTriggerDb;User Id=YOUR-USER;Password=YOUR-PASSWORD;SSL Mode=Require;Trust Server Certificate=true;",
    "// Sqlite": "Local file, no server needed - handy for running/testing the app without an Azure database.",
    "Sqlite": "Data Source=scaletrigger.db"
  },

  "Cache": {
    "// Enabled": "true = voting results are cached (MemoryCache); false = every retrieval goes straight to the database",
    "Enabled": true,
    "SlidingExpirationMinutes": 5
  },

  "// ConfigRefresh": "Seconds between polls of the LoadConfig database table for values changed via the dashboard. Only affects how fast an edit takes effect - it does not change the values themselves.",
  "ConfigRefresh": 10,

  "Load": {
    "// Note": "Used only to seed the LoadConfig database table the very first time it's created - see 'ConfigRefresh' above. After that, this section is no longer read; edit the running values from the dashboard instead. Each value is picked fresh, at random, between Min and Max for every vote. Use Min == Max for a fixed value.",
    "CpuIterationsPerVote": { "Min": 150000, "Max": 250000 },
    "MemoryMegabytesPerVote": { "Min": 3, "Max": 8 },
    "DiskWriteKilobytesPerVote": { "Min": 32, "Max": 96 },
    "NetworkLatencyMillisecondsPerVote": { "Min": 10, "Max": 30 },
    "// PayloadBytesPerVote": "0 = no Payload table insert for that vote. Off by default, since unlike the others this permanently grows the database - opt in for write-throughput benchmarking.",
    "PayloadBytesPerVote": { "Min": 0, "Max": 0 },
    "// DbHashIterationsPerVote": "0 = VoteAdd just inserts, no hash loop. Runs inside the database engine itself (unlike CpuIterationsPerVote, which runs in the app) - simulates database-side CPU load.",
    "DbHashIterationsPerVote": { "Min": 0, "Max": 0 }
  },

  "Jwt": {
    "Key": "abcdefghijklmnopqrstuvwxyz012345",
    "Issuer": "ScaleTrigger",
    "Audience": "ScaleTrigger.Clients",
    "ExpirationMinutes": 60
  },

  "AdminUser": {
    "Username": "admin",
    "Password": "admin"
  }
}
